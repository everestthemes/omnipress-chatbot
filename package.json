{
	"name": "omnipress-ai-chatbot",
	"version": "0.1.0",
	"description": "OmniPress AI Chatbot",
	"main": "index.js",
	"license": "MIT",
	"author": "n1technology",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/everestthemes/omnipress-ai-chatbot.git"
	},
	"scripts": {
		"build": "wp-scripts build src/admin/index.js src/client/chatbot.js --output-path=build/js",
		"start": "wp-scripts start src/admin/index.js src/client/chatbot.js --output-path=build/js",
		"format": "wp-scripts format ./src",
		"tailwind:watch": "npx @tailwindcss/cli -i ./src/index.css -o ./build/css/global.css --watch",
		"build:css": "npx @tailwindcss/cli -i ./src/index.css -o ./build/css/global.css --minify"
	},
	"devDependencies": {
		"@types/react": "^19.1.9",
		"@wordpress/scripts": "^30.21.0"
	},
	"dependencies": {
		"@radix-ui/react-label": "^2.1.7",
		"@radix-ui/react-slot": "^1.2.3",
		"@radix-ui/react-switch": "^1.2.5",
		"@radix-ui/react-tooltip": "^1.2.7",
		"@tailwindcss/cli": "^4.1.11",
		"@wordpress/api-fetch": "^7.28.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^0.539.0",
		"next-themes": "^0.4.6",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.3.1",
		"tailwindcss": "^4.1.11",
		"tw-animate-css": "^1.3.6"
	}
}
